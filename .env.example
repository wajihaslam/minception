# ============================================================
# Minception — Environment Variables Template
# Copy this to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# ---- MongoDB ----
MONGO_DEV_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/api_gateway_dev
MONGO_STAGING_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/api_gateway_staging
MONGO_PROD_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/api_gateway_prod

# Active connection (set per environment)
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/api_gateway_dev

# ---- Auth (Admin Service) ----
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Default Admin User (created on first startup) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@simpaisa.com
ADMIN_PASSWORD=changeme123

# ---- Service URLs ----
MOCK_SERVICE_URL=http://mock-service:8001
ADMIN_SERVICE_URL=http://admin-service:8002

# ---- App ----
FASTAPI_ENV=development
LOG_LEVEL=debug

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:80
