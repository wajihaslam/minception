# ============================================================
# Minception — Environment Variables Template
# Copy this to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# ---- MongoDB ----
# Used inside Docker containers (service name as host)
MONGO_URL=mongodb://mongodb:27017/api_gateway_dev

# Used by migration runner: pick the env-specific URL
MONGO_DEV_URL=mongodb://localhost:27017/api_gateway_dev
MONGO_STAGING_URL=
MONGO_PROD_URL=

# ---- Auth (Admin Service) ----
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Default Admin User (seeded on first startup) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ---- Service URLs ----
MOCK_SERVICE_URL=http://mock-service:8001
ADMIN_SERVICE_URL=http://admin-service:8002

# ---- App ----
FASTAPI_ENV=development
LOG_LEVEL=debug

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:80
