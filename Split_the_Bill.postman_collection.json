{
  "info": {
    "name": "Split-the-Bill (Mock)",
    "description": "Mock gateway for the Split-the-Bill app.\n\nBase path: /api\nAll requests hit the Mock Service via nginx at /mock/api/...\n\nFlavor selection via X-Scenario header:\n  (no header)                   → Success (default)\n  X-Scenario: validation_error  → 422 Validation Error\n  X-Scenario: unauthorized      → 401 Unauthorized\n  X-Scenario: not_found         → 404 Not Found\n  X-Scenario: conflict          → 409 Conflict / Already Paid / Expired\n  X-Scenario: server_error      → 500 Internal Server Error",
    "_postman_id": "split-the-bill-mock",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:80",           "type": "string" },
    { "key": "mock_base", "value": "{{base_url}}/mock/api",         "type": "string" },
    { "key": "bill_id",   "value": "bill_01MOCK",                   "type": "string" },
    { "key": "link_id",   "value": "lnk_03MOCK",                    "type": "string" }
  ],
  "item": [

    {
      "name": "POST /bills — Create Bill",
      "description": "Create a bill, split the amount, generate per-person payment links.",
      "item": [
        {
          "name": "Success — Bill Created (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner at Cosa Nostra\",\n  \"total_amount\": 4500.00,\n  \"participant_count\": 4\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        },
        {
          "name": "Validation Error — Bad Input (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Scenario",   "value": "validation_error" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_amount\": -100,\n  \"participant_count\": 1\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        },
        {
          "name": "Unauthorized (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Scenario",   "value": "unauthorized" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner at Cosa Nostra\",\n  \"total_amount\": 4500.00,\n  \"participant_count\": 4\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        },
        {
          "name": "Not Found — Referenced Resource (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Scenario",   "value": "not_found" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner at Cosa Nostra\",\n  \"total_amount\": 4500.00,\n  \"participant_count\": 4\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        },
        {
          "name": "Conflict — Duplicate Bill (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Scenario",   "value": "conflict" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner at Cosa Nostra\",\n  \"total_amount\": 4500.00,\n  \"participant_count\": 4\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        },
        {
          "name": "Server Error (500)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Scenario",   "value": "server_error" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner at Cosa Nostra\",\n  \"total_amount\": 4500.00,\n  \"participant_count\": 4\n}"
            },
            "url": { "raw": "{{mock_base}}/bills", "host": ["{{mock_base}}"], "path": ["bills"] }
          }
        }
      ]
    },

    {
